# Copy to .env and fill in. .env is git-ignored.

# Any OpenAI-compatible endpoint. Default: OpenRouter.
# Local servers: http://localhost:11434/v1 (Ollama), http://localhost:8000/v1 (vLLM), http://localhost:1234/v1 (LM Studio)
LLM_BASE_URL=https://openrouter.ai/api/v1
# Not needed for a server on localhost.
LLM_API_KEY=

# Model ID as the endpoint names it (OpenRouter: https://openrouter.ai/models).
# For testing, a Claude model can be used through OpenRouter, e.g. anthropic/claude-opus-5.5
# (check the exact ID on that page).
CLASSIFIER_MODEL=

# Optional overrides
# CLASSIFIER_EFFORT=low                   # reasoning effort; only for models that support it
# CLASSIFIER_RESPONSE_FORMAT=json_schema  # json_schema | json_object (no schema support) | none
# PORT=5000
